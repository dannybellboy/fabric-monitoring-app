    },
    {
      "key": "uat",
      "workspace_id": "<uat-workspace-guid>"
    },
    {
      "key": "prd",
      "workspace_id": "<prd-workspace-guid>"
    }
  ],

  "datadog_dashboard_url": "<datadog-secure-embed-base-url>"
